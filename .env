# Valeurs par défaut, versionnées. Aucun secret réel ici : surcharger dans .env.local
# (non versionné) ou par de vraies variables d'environnement, qui gagnent toujours.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Suivi des erreurs (GlitchTip, DSN au format Sentry). Vide : rien n'est chargé ni envoyé.
# Valeurs réelles dans .env.local, jamais versionnées.
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=

# Mesure d'audience Matomo, sans cookie. Les deux vides : rien n'est chargé ni envoyé.
MATOMO_URL=
MATOMO_SITE_ID=

# API commune : 8090 pour API Platform, 8091 pour Hono. Les conteneurs sont sur le réseau de l'hôte.
API_URL=http://localhost:8090
# Scénario de l'API fixé pour tous les appels du site, à défaut d'en-tête X-Scenario reçu (bilingual : site en français et
# en anglais, tests e2e du site bilingue). Vide en dehors des tests ; l'API ne l'honore qu'en dev et en test.
API_SCENARIO=

# URL publique du site : URL canoniques, Open Graph, sitemap, et URL générées hors requête
SITE_URL=http://localhost:8095
