{%- set filters = state.query.filters -%}
{%- set sales_enabled = site_identity().salesEnabled -%}
<div class="catalog__layout">
    {% if result %}
        {{ include('catalog/_filters.html.twig') }}
    {% endif %}
    <div class="catalog__main">
        {% if error %}
            {% embed 'shared/ui/_alert.html.twig' with {variant: 'error', body: 'catalog.load_error'|trans, testid: 'catalog-error'} %}
                {% block action %}
                    <a class="bui-button bui-button--outline" href="{{ category_path ~ state.queryString() }}" data-testid="catalog-retry">
                        {{ include('shared/ui/_icon.html.twig', {name: 'rotate-cw'}) }}
                        <span>{{ 'common.retry'|trans }}</span>
                    </a>
                {% endblock %}
            {% endembed %}
        {% else %}
            <div class="catalog__toolbar">
                <button type="button" class="bui-button bui-button--outline catalog__filters-open" aria-haspopup="dialog" aria-expanded="false" aria-controls="catalog-filters" data-catalog-target="opener" data-action="catalog#openFilters" data-testid="catalog-filters-open">
                    {{ include('shared/ui/_icon.html.twig', {name: 'sliders-horizontal'}) }}
                    <span>{{ 'catalog.filter'|trans }}{% if filters.activeCount > 0 %} ({{ filters.activeCount }}<span class="bui-visually-hidden">{{ 'catalog.active_count'|trans }}</span>){% endif %}</span>
                </button>
                <p class="catalog__count" role="status" data-catalog-target="count" data-testid="catalog-results-count">{{ 'catalog.count'|trans({'%count%': product_count}) }}</p>
                <div class="catalog__sort">
                    <label for="catalog-sort">{{ 'catalog.sort_by'|trans }}</label>
                    <select id="catalog-sort" name="tri" form="catalog-filters-form" data-action="catalog#apply" data-testid="catalog-sort">
                        {% for sort in enum('App\\Catalog\\Domain\\ProductSort').cases()|filter(sort => sales_enabled or not sort.byPrice) %}
                            <option value="{{ sort.value }}"{% if sort == state.query.sort %} selected{% endif %}>{{ ('catalog.sort.' ~ sort.value)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
                <nav class="catalog__views" aria-label="{{ 'catalog.display'|trans }}">
                    <a class="bui-button bui-button--outline" href="{{ category_path ~ state.withView(enum('App\\Catalog\\UI\\ListView').Grid).queryString() }}"{% if state.view.value == 'grille' %} aria-current="page"{% endif %} data-testid="catalog-view-grid">
                        {{ include('shared/ui/_icon.html.twig', {name: 'layout-grid'}) }}
                        <span>{{ 'catalog.grid'|trans }}</span>
                    </a>
                    <a class="bui-button bui-button--outline" href="{{ category_path ~ state.withView(enum('App\\Catalog\\UI\\ListView').List).queryString() }}"{% if state.view.value == 'liste' %} aria-current="page"{% endif %} data-testid="catalog-view-list">
                        {{ include('shared/ui/_icon.html.twig', {name: 'list'}) }}
                        <span>{{ 'catalog.list'|trans }}</span>
                    </a>
                </nav>
            </div>

            {% if filters.activeCount > 0 %}
                <div class="catalog__active" data-testid="catalog-active-filters">
                    <ul class="bui-chip-list chips" role="list" aria-label="{{ 'catalog.active_filters'|trans }}">
                        {% for exposure in filters.exposures %}
                            {{ include('catalog/_active_filter.html.twig', {label: ('catalog.exposure.' ~ exposure.value)|trans, href: category_path ~ state.withoutExposure(exposure).queryString()}) }}
                        {% endfor %}
                        {% for size in filters.sizes %}
                            {{ include('catalog/_active_filter.html.twig', {label: ('catalog.size.' ~ size.value)|trans, href: category_path ~ state.withoutSize(size).queryString()}) }}
                        {% endfor %}
                        {% for code, values in filters.attributes %}
                            {% set facet = result.facets.attribute(code) %}
                            {% for value in values %}
                                {{ include('catalog/_active_filter.html.twig', {label: (facet ? facet.label ~ ' : ' ~ (facet.valueLabel(value) ?? value) : value), href: category_path ~ state.withoutAttribute(code, value).queryString()}) }}
                            {% endfor %}
                        {% endfor %}
                        {% if filters.priceMin is not null %}
                            {{ include('catalog/_active_filter.html.twig', {label: 'catalog.active_price_min'|trans({'%euros%': filters.priceMin.euros}), href: category_path ~ state.withoutPriceMin().queryString()}) }}
                        {% endif %}
                        {% if filters.priceMax is not null %}
                            {{ include('catalog/_active_filter.html.twig', {label: 'catalog.active_price_max'|trans({'%euros%': filters.priceMax.euros}), href: category_path ~ state.withoutPriceMax().queryString()}) }}
                        {% endif %}
                        {% if filters.inStockOnly %}
                            {{ include('catalog/_active_filter.html.twig', {label: 'catalog.in_stock'|trans, href: category_path ~ state.withoutInStock().queryString()}) }}
                        {% endif %}
                    </ul>
                    <a class="catalog__clear" href="{{ category_path ~ state.cleared().queryString() }}" data-catalog-focus="title" data-testid="catalog-clear-filters">{{ 'catalog.clear'|trans }}</a>
                </div>
            {% endif %}

            <div class="catalog__loading" role="status" aria-label="{{ 'catalog.loading'|trans }}">
                {% for i in 1..4 %}<span class="bui-skeleton skeleton--card" aria-hidden="true"></span>{% endfor %}
            </div>

            {% if result.page.items is empty %}
                {% embed 'shared/ui/_alert.html.twig' with {body: 'catalog.empty'|trans, testid: 'catalog-empty'} %}
                    {% block action %}
                        <a class="bui-button bui-button--outline" href="{{ category_path ~ state.cleared().queryString() }}" data-catalog-focus="title">{{ 'catalog.clear'|trans }}</a>
                    {% endblock %}
                {% endembed %}
            {% else %}
                <ul class="product-list product-list--{{ state.view.value }}" role="list">
                    {% for product in result.page.items %}
                        <li class="product-list__item">
                            <article class="product" id="{{ product.slug }}" data-testid="catalog-product">
                                {% if product.image %}
                                    <picture class="bui-picture">
                                        {% for source in product.image.sources %}
                                            <source type="{{ source.type }}" sizes="(min-width: 1024px) 290px, (min-width: 528px) 50vw, 100vw" srcset="{{ source.srcset }}">
                                        {% endfor %}
                                        <img class="product__image" src="{{ product.image.src }}" alt="{{ product.image.alt }}" width="{{ product.image.width }}" height="{{ product.image.height }}"{% if loop.first %} fetchpriority="high"{% elseif loop.index > 4 %} loading="lazy" decoding="async"{% endif %}>
                                    </picture>
                                {% else %}
                                    <div class="product__image product__image--empty"></div>
                                {% endif %}
                                <div class="product__body">
                                    <h2 class="product__name"><a class="product__link" href="{{ path('product', {slug: product.slug}) }}" data-turbo-frame="_top" data-testid="catalog-product-link">{{ product.name }}</a></h2>
                                    {% if sales_enabled %}
                                        <p class="product__price" data-testid="catalog-product-price" data-price="{{ product.price.cents }}">{{ product.price|price }}</p>
                                    {% endif %}
                                    <dl class="product__details">
                                        <div><dt>{{ 'catalog.exposure_label'|trans }}</dt><dd>{{ ('catalog.exposure.' ~ product.exposure.value)|trans }}</dd></div>
                                        <div><dt>{{ 'catalog.size_label'|trans }}</dt><dd>{{ ('catalog.size.' ~ product.size.value)|trans }}</dd></div>
                                    </dl>
                                    {% if not product.inStock %}
                                        <p><span class="bui-badge bui-badge--error">{{ 'catalog.out_of_stock'|trans }}</span></p>
                                    {% endif %}
                                </div>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if result.page.pageCount > 1 %}
                {{ include('catalog/_pagination.html.twig', {current: result.page.page, page_count: result.page.pageCount}) }}
            {% endif %}
        {% endif %}
    </div>
</div>
