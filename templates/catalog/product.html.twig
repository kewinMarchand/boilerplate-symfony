{% extends 'base.html.twig' %}

{%- set breadcrumb = [{label: 'Catalogue', path: path('catalog')}] -%}
{%- if detail -%}
    {%- set product = detail.product -%}
    {%- set category = detail.category -%}
    {%- for step in detail.categoryPath -%}
        {%- set breadcrumb = breadcrumb|merge([{label: step.name, path: path('catalog', {path: step.path})}]) -%}
    {%- endfor -%}
    {%- set url = site.url ~ path('product', {slug: product.slug}) -%}
    {%- set image = product.image -%}
    {%- set largest = image ? (image.sources|filter(source => source.type == 'image/webp')|first).srcset|split(', ')|last|split(' ')|first : null -%}
    {%- set seo = seo_page({
        title: product.name,
        meta_title: detail.metaTitle,
        description: detail.metaDescription ?: product.name ~ ' : exposition ' ~ product.exposure.label|lower ~ ', taille ' ~ product.size.value ~ ', ' ~ product.price|price ~ '. ' ~ (product.inStock ? 'En stock' : 'En rupture de stock') ~ ', rayon ' ~ (category ? category.name : 'catalogue') ~ '.',
        breadcrumb: breadcrumb|merge([{label: product.name}]),
        image: image ? {url: largest, width: image.width, height: image.height, alt: image.alt ?: product.name} : null,
        json_ld: [{
            '@context': 'https://schema.org',
            '@type': 'Product',
            name: product.name,
            description: detail.description is empty ? null : detail.description|join(' '),
            sku: product.slug,
            url: url,
            category: category ? category.name : null,
            image: largest,
            offers: {
                '@type': 'Offer',
                url: url,
                priceCurrency: 'EUR',
                price: (product.price.cents / 100)|number_format(2, '.', ''),
                availability: 'https://schema.org/' ~ (product.inStock ? 'InStock' : 'OutOfStock'),
            },
        }|filter(value => value is not null)],
    }|filter(value => value is not null)) -%}
{%- else -%}
    {%- set seo = seo_page({title: 'Produit', description: 'Fiche produit de la jardinerie tropicale ' ~ site_identity().name ~ '.', breadcrumb: breadcrumb|merge([{label: 'Produit'}]), robots: 'noindex, follow'}) -%}
{%- endif -%}

{% block preload %}
    {% if detail and detail.product.image %}
        {% set first = detail.product.image.sources|first %}
        <link rel="preload" as="image" type="{{ first.type }}" imagesrcset="{{ first.srcset }}" imagesizes="(min-width: 1440px) 680px, (min-width: 768px) 50vw, calc(100vw - 32px)" fetchpriority="high">
    {% endif %}
{% endblock %}

{% block body %}
    {% if detail %}
        {% set product = detail.product %}
        <article class="product-page" data-testid="product-page">
            <div class="product-page__layout">
                {%- set image_sizes = '(min-width: 1440px) 680px, (min-width: 768px) 50vw, calc(100vw - 32px)' %}
                {% if detail.gallery is not empty %}
                    {%- set images = (product.image ? [product.image] : [])|merge(detail.gallery) %}
                    <div class="product-gallery" data-testid="product-gallery" data-controller="product-gallery">
                        <div data-product-gallery-target="main">
                            {{ include('shared/ui/_picture.html.twig', {image: images|first, sizes: image_sizes, class: 'product-page__image', priority: true}) }}
                        </div>
                        {% for image in images %}
                            <template data-product-gallery-target="image">{{ include('shared/ui/_picture.html.twig', {image: image, sizes: image_sizes, class: 'product-page__image'}) }}</template>
                        {% endfor %}
                        <ul class="product-gallery__thumbs" role="list">
                            {% for image in images %}
                                <li>
                                    <a class="product-gallery__thumb" href="{{ image.sources is empty ? image.src : (image.sources|last).srcset|split(', ')|last|split(' ')|first }}" aria-label="Voir l’image {{ loop.index }} sur {{ images|length }}"
                                        {%- if loop.first %} aria-current="true"{% endif %} data-testid="product-gallery-thumb" data-product-gallery-target="thumb" data-action="click->product-gallery#show keydown->product-gallery#move">
                                        {{- include('shared/ui/_picture.html.twig', {image: image, sizes: '80px', decorative: true}) -}}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% elseif product.image %}
                    {{ include('shared/ui/_picture.html.twig', {image: product.image, sizes: image_sizes, class: 'product-page__image', priority: true}) }}
                {% endif %}
                <div>
                    <h1 data-testid="product-title">{{ product.name }}</h1>
                    <p class="product-page__price" data-testid="product-price">{{ product.price|price }}</p>
                    {% if detail.description is not empty %}
                        <div data-testid="product-description">
                            {% for paragraph in detail.description %}
                                <p>{{ paragraph }}</p>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <dl class="product-page__features">
                        <dt>Exposition</dt>
                        <dd>{{ product.exposure.label }}</dd>
                        <dt>Taille</dt>
                        <dd>{{ product.size.value }}</dd>
                        <dt>Disponibilité</dt>
                        <dd>{% if product.inStock %}En stock{% else %}<span class="bui-badge bui-badge--error">Rupture de stock</span>{% endif %}</dd>
                    </dl>
                    {% if product.attributes is not empty %}
                        <dl class="product-page__features" data-testid="product-attributes">
                            {% for attribute in product.attributes %}
                                <dt>{{ attribute.label }}</dt>
                                <dd>{{ attribute.valueLabel }}{% if attribute.unit %}&nbsp;{{ attribute.unit }}{% endif %}</dd>
                            {% endfor %}
                        </dl>
                    {% endif %}
                    {{ include(purchase, {item: {slug: product.slug, name: product.name, price: product.price.cents}, available: product.inStock}) }}
                    {% if detail.category %}
                        <p><a class="bui-link" href="{{ path('catalog', {path: detail.category.path}) }}">Voir les autres produits : {{ detail.category.name }}</a></p>
                    {% endif %}
                </div>
            </div>
        </article>
        {% if similar is not empty %}
            {{ include('shared/carousel/_carousel.html.twig', {
                id: 'product-similar',
                title: 'Produits similaires',
                testid: 'product-similar',
                slides: similar|map(other => {
                    image: other.image,
                    title: other.name,
                    text: other.price|price,
                    href: path('product', {slug: other.slug}),
                }),
            }) }}
        {% endif %}
    {% else %}
        <h1>Produit</h1>
        {{ include('shared/ui/_alert.html.twig', {variant: 'error', body: error, testid: 'product-error'}) }}
    {% endif %}
{% endblock %}
