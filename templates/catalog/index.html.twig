{% extends 'base.html.twig' %}

{%- set category = categoryPath.category -%}
{%- set category_path = path('catalog', {path: categoryPath.value}) -%}
{%- set page = state.query.page -%}
{%- set product_count = result ? result.page.total : 0 -%}
{%- set breadcrumb = [{label: 'nav.catalog'|trans, path: path('catalog')}] -%}
{%- for step in categoryPath.steps -%}
    {%- set breadcrumb = breadcrumb|merge([{label: step.category.name, path: path('catalog', {path: step.value})}]) -%}
{%- endfor -%}
{%- set page_suffix = page > 1 ? 'catalog.page_suffix'|trans({'%page%': page}) : '' -%}
{%- set seo = seo_page({
    page: categoryPath.isRoot and page == 1 ? 'catalog' : null,
    title: (categoryPath.isRoot ? 'nav.catalog'|trans : category.name ~ ' · ' ~ 'nav.catalog'|trans) ~ page_suffix,
    description: 'catalog.description'|trans({'%subject%': categoryPath.isRoot ? 'catalog.whole_catalogue'|trans : category.name|lower}),
    breadcrumb: breadcrumb,
    alternates: categoryPath.isRoot ? null : categoryPath.alternates|map(alternate => {path: alternate}),
    canonical: category_path ~ (page > 1 ? '?page=' ~ page : ''),
    robots: state.hasFiltersOrSort() ? 'noindex, follow' : 'index, follow',
    prev: result and page > 1 ? category_path ~ state.withPage(page - 1).queryString() : null,
    next: result and page < result.page.pageCount ? category_path ~ state.withPage(page + 1).queryString() : null,
    json_ld: result ? [{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        numberOfItems: result.page.total,
        itemListElement: result.page.items|map((product, index) => {
            '@type': 'ListItem',
            position: (page - 1) * constant('App\\Catalog\\Domain\\CatalogQuery::PER_PAGE') + index + 1,
            name: product.name,
            url: site.url ~ category_path ~ '#' ~ product.slug,
        }),
    }] : [],
}) -%}

{% block preload %}
    {% set first_image = result and result.page.items is not empty ? (result.page.items|first).image : null %}
    {% if first_image %}
        {% set first = first_image.sources|first %}
        <link rel="preload" as="image" type="{{ first.type }}" imagesrcset="{{ first.srcset }}" imagesizes="(min-width: 1024px) 290px, (min-width: 528px) 50vw, 100vw" fetchpriority="high">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="catalog" data-controller="catalog" data-action="click->catalog#trackClick turbo:before-fetch-request->catalog#rememberFocus turbo:frame-load->catalog#restoreFocus">
        <h1 class="catalog__title" tabindex="-1" data-catalog-target="title">{{ categoryPath.isRoot ? 'nav.catalog'|trans : category.name }}</h1>
        {% if category.children is not empty %}
            <ul class="bui-chip-list chips" role="list" aria-label="{{ 'catalog.subcategories'|trans }}">
                {% for child in category.children %}
                    <li><a class="bui-chip" href="{{ path('catalog', {path: categoryPath.child(child).value}) }}">{{ child.name }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="bui-visually-hidden" role="status" data-catalog-target="announcer"></p>
        <turbo-frame id="catalog-results" class="catalog__frame" data-turbo-action="advance">
            {{ include('catalog/_results.html.twig') }}
        </turbo-frame>
    </div>
{% endblock %}
