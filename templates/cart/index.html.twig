{% extends 'base.html.twig' %}

{% set seo = seo_page({title: 'Panier', description: 'Votre panier : les produits choisis, leurs quantités et le total, gardés dans ce navigateur.', robots: 'noindex, follow'}) %}

{% block body %}
    <h1>Panier</h1>
    <noscript><p>Le panier demande JavaScript.</p></noscript>
    <div data-controller="cart">
        <div data-cart-target="content"></div>
        <template data-cart-target="empty">
            <p data-testid="cart-empty">Votre panier est vide. <a class="bui-link" href="{{ path('catalog') }}">Parcourir le catalogue</a></p>
        </template>
        <template data-cart-target="summary">
            <ul class="cart-lines" role="list" data-cart-lines></ul>
            <p class="cart-total">Total : <span data-cart-total data-testid="cart-total"></span></p>
            <p>La commande en ligne arrive bientôt.</p>
        </template>
        <template data-cart-target="line">
            <li class="cart-line" data-testid="cart-line">
                <a class="bui-link cart-line__name" data-field="name"></a>
                <span data-field="unit-price"></span>
                <div class="bui-field cart-line__quantity">
                    <label class="bui-field__label" data-field="label"></label>
                    <input class="bui-field__input" type="number" min="1" max="99" data-field="quantity" data-action="cart#changeQuantity" data-testid="cart-quantity">
                </div>
                <span class="cart-line__subtotal" data-field="subtotal"></span>
                <button type="button" class="bui-button bui-button--outline" data-field="remove" data-action="cart#remove" data-testid="cart-remove">Retirer</button>
            </li>
        </template>
    </div>
{% endblock %}
