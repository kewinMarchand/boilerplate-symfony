{#- cart_link : lien du panier, fourni par le layout du site (le socle ne connaît pas le module panier) -#}
{% set tree = catalog_tree() %}
<header class="header" data-controller="mobile-menu">
    <div class="header__inner container">
        <a class="header__logo" href="{{ path('home') }}" data-testid="layout-logo"{% if app.current_route == 'home' %} aria-current="page"{% endif %}>
            {%- set identity = site_identity() %}
            {% if identity.logo %}
                {%- set logo_width = (40 * identity.logo.width / identity.logo.height)|round %}
                {%- set webp = identity.logo.sources|filter(source => source.type == 'image/webp')|first %}
                <img class="header__logo-image" src="{{ identity.logo.src }}"{% if webp %} srcset="{{ webp.srcset }}" sizes="{{ logo_width }}px"{% endif %} alt="{{ identity.name }}" width="{{ logo_width }}" height="40" fetchpriority="high" data-testid="layout-logo-image">
            {% else %}
                <img src="{{ asset('images/logo-mark.svg') }}" alt="" width="36" height="36">
                <span>{{ identity.name }}</span>
            {% endif %}
        </a>
        <nav class="header__nav" aria-label="Navigation principale">
            <ul class="nav-list" role="list">
                {% for item in site.navigation.main %}
                    {% if item.route == 'catalog' %}
                        {{ include('shared/layout/_category_menu.html.twig') }}
                    {% else %}
                        <li>
                            <a class="nav-link" href="{{ path(item.route) }}"{% if app.current_route == item.route %} aria-current="page"{% endif %}>{{ item.label }}</a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </nav>
        <div class="header__actions">
            {{ cart_link }}
            <button type="button" class="bui-button bui-button--inverse mobile-menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-target="toggle" data-action="mobile-menu#open" data-testid="layout-mobile-menu-toggle">
                {{ include('shared/ui/_icon.html.twig', {name: 'menu'}) }}
                <span class="header__action-label">Menu</span>
            </button>
            {{ include('shared/layout/_color_scheme_toggle.html.twig') }}
            <button type="button" class="bui-button bui-button--inverse a11y-toggle" aria-label="Accessibilité renforcée" aria-pressed="false" data-controller="a11y-mode" data-action="a11y-mode#toggle" data-testid="a11y-mode-toggle">
                {{ include('shared/ui/_icon.html.twig', {name: 'person-standing'}) }}
                <span class="header__action-label">Accessibilité renforcée</span>
            </button>
        </div>
    </div>
    {{ include('shared/layout/_mobile_menu.html.twig') }}
</header>
