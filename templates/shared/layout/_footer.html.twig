<footer class="footer" data-testid="layout-footer">
    <div class="footer__inner container">
        <nav aria-label="{{ 'layout.legal_links'|trans }}">
            <ul class="footer__links" role="list">
                {% for item in site.navigation.legal %}
                    <li>
                        <a href="{{ path(item.route) }}"{% if app.current_route == item.route %} aria-current="page"{% endif %}>{% if item.route == 'legal_accessibility' %}{{ 'legal.compliance_link'|trans({'%label%': item.label|trans, '%status%': ('legal.compliance.' ~ accessibility_compliance().name)|trans}) }}{% else %}{{ item.label|trans }}{% endif %}</a>
                    </li>
                {% endfor %}
                {% if app.environment == 'dev' %}
                    <li><a href="{{ path('styleguide') }}">{{ 'layout.styleguide'|trans }}</a></li>
                {% endif %}
            </ul>
        </nav>
        <p class="footer__brand">
            <img src="{{ asset('images/logo-mark.svg') }}" alt="" width="20" height="20">
            <span>{{ site_identity().name }}</span>
        </p>
    </div>
</footer>
