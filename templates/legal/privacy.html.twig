{% extends 'base.html.twig' %}

{% set seo = seo_page({page: 'privacy', title: 'nav.legal_privacy'|trans, description: 'legal.privacy_description'|trans({'%site%': site_identity().name})}) %}

{% block body %}
    <article class="prose">
        {{ include('legal/_page_content.html.twig', {fallback_title: 'nav.legal_privacy'|trans}) }}

        {% if matomo() %}
            <section aria-labelledby="mesure-audience" data-testid="legal-audience-measurement">
                <h2 id="mesure-audience">{{ 'privacy.audience'|trans }}</h2>
                <p>{{ 'privacy.audience_text'|trans }}</p>
                <p>{{ 'privacy.opposition'|trans }}</p>
                <div data-controller="opposition-mesure" data-opposition-mesure-refused-value="{{ 'privacy.refused'|trans }}" data-opposition-mesure-measured-value="{{ 'privacy.measured'|trans }}">
                    <div class="bui-checkbox">
                        <input class="bui-checkbox__input" id="opposition-mesure" type="checkbox" data-opposition-mesure-target="input" data-action="opposition-mesure#change" data-testid="legal-opposition-mesure">
                        <label class="bui-checkbox__label" for="opposition-mesure">{{ 'privacy.opt_out'|trans }}</label>
                    </div>
                    <p role="status" aria-live="polite" data-opposition-mesure-target="status" data-testid="legal-opposition-etat"></p>
                </div>
            </section>
        {% endif %}
    </article>
{% endblock %}
