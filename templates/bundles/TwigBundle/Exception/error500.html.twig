{% extends 'base.html.twig' %}

{% set seo = seo_page({title: 'error.server'|trans, description: 'error.server_description'|trans, robots: 'noindex', canonical: false, breadcrumb: [{label: 'error.server'|trans}]}) %}

{% block body %}
    <h1>{{ 'error.server'|trans }}</h1>
    <p class="lead">{{ 'error.server_lead'|trans }}</p>
    <ul class="error-links" role="list">
        <li><a class="bui-button" href="{{ app.request.requestUri }}" data-testid="error-retry">{{ 'common.retry'|trans }}</a></li>
        <li><a class="bui-button bui-button--outline" href="{{ path('home') }}" data-testid="error-home-link">{{ 'error.home'|trans }}</a></li>
    </ul>
{% endblock %}
