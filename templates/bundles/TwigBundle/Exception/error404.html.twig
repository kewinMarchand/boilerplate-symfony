{% extends 'base.html.twig' %}

{% set seo = seo_page({title: 'error.not_found'|trans, description: 'error.not_found_description'|trans, robots: 'noindex', canonical: false, breadcrumb: [{label: 'error.not_found'|trans}]}) %}

{% block body %}
    <h1>{{ 'error.not_found'|trans }}</h1>
    <p class="lead">{{ 'error.not_found_lead'|trans }}</p>
    <ul class="error-links" role="list">
        <li><a class="bui-button" href="{{ path('home') }}" data-testid="error-home-link">{{ 'error.home'|trans }}</a></li>
        <li><a class="bui-button bui-button--outline" href="{{ path('legal_sitemap') }}">{{ 'nav.legal_sitemap'|trans }}</a></li>
        <li><a class="bui-button bui-button--outline" href="{{ path('catalog') }}">{{ 'nav.catalog'|trans }}</a></li>
    </ul>
{% endblock %}
