{% extends 'base.html.twig' %}

{% block preload %}
    <link rel="preload" as="image" type="image/avif" imagesrcset="{{ asset('images/hero-640.avif') }} 640w, {{ asset('images/hero-1280.avif') }} 1280w, {{ asset('images/hero-1920.avif') }} 1920w" imagesizes="100vw" fetchpriority="high">
{% endblock %}

{% block main %}
    <section class="hero" aria-labelledby="home-title" data-testid="home-hero">
        {{ include('shared/ui/_picture.html.twig', {name: 'hero', widths: [640, 1280, 1920], sizes: '100vw', class: 'hero__image', priority: true}) }}
        <div class="hero__content container">
            <p class="hero__eyebrow">Symfony 8.1, Twig, Stimulus, Turbo</p>
            {%- set identity = site_identity() %}
            <h1 id="home-title" class="hero__title">{{ identity.name }}</h1>
            {% if identity.tagline %}<p class="hero__lead">{{ identity.tagline }}</p>{% endif %}
            <div class="hero__actions">
                <a class="bui-button" href="{{ path('tasks') }}" data-testid="home-tasks-link">Voir la démo Turbo Frame</a>
                <a class="bui-button bui-button--inverse" href="{{ path('contact') }}" data-testid="home-contact-link">Voir le formulaire</a>
            </div>
        </div>
    </section>

    <div class="container main__content">
        {% if featured_error %}
            {{ include('shared/ui/_alert.html.twig', {variant: 'error', body: featured_error, testid: 'home-carousel-error'}) }}
        {% elseif featured is not empty %}
            {{ include('shared/carousel/_carousel.html.twig', {
                id: 'home-carousel',
                title: 'À la une',
                testid: 'home-carousel',
                slides: featured|map(product => {
                    image: product.image,
                    title: product.name,
                    text: product.price|price,
                    href: path('product', {slug: product.slug}),
                }),
            }) }}
        {% endif %}

        <section class="blog" aria-labelledby="home-blog-title" data-testid="home-blog">
            <h2 id="home-blog-title">Derniers articles</h2>
            {% if articles_error %}
                {{ include('shared/ui/_alert.html.twig', {variant: 'error', body: articles_error, testid: 'home-blog-error'}) }}
            {% elseif articles is empty %}
                {{ include('shared/ui/_alert.html.twig', {body: 'Aucun article pour l’instant. Revenez bientôt.', testid: 'home-blog-empty'}) }}
            {% else %}
                <ul class="blog__grid" role="list">
                    {% for article in articles %}
                        <li class="blog__item">
                            {{ include('blog/_card.html.twig', {article: article, testid: 'home-blog-card', sizes: loop.first ? '(min-width: 1024px) calc((min(100vw, 1440px) - 64px) * 2 / 3), (min-width: 768px) 100vw, 100vw' : '(min-width: 1024px) calc((min(100vw, 1440px) - 64px) / 3), (min-width: 768px) 50vw, 100vw'}) }}
                        </li>
                    {% endfor %}
                </ul>
                <p class="blog__all"><a class="bui-link" href="{{ path('blog') }}" data-testid="home-blog-all">Tous les articles</a></p>
            {% endif %}
        </section>
    </div>
{% endblock %}
