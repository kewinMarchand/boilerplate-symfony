{% extends 'base.html.twig' %}

{% set seo = seo_page({page: 'contact', title: 'nav.contact'|trans, description: 'contact.description'|trans}) %}

{% block body %}
    <h1>{{ 'nav.contact'|trans }}</h1>
    <p class="lead">{{ 'contact.lead'|trans }}</p>
    {% if product %}
        <p data-testid="contact-product">{{ 'contact.product'|trans }}<a class="bui-link" href="{{ path('product', {slug: product.slug}) }}">{{ product.name }}</a></p>
    {% endif %}
    {{ include('contact/_form.html.twig') }}
    <div id="contact-status" class="contact-status" aria-live="polite">
        {% for message in app.flashes('contact_success') %}
            {{ include('shared/ui/_alert.html.twig', {variant: 'success', body: message|trans, testid: 'contact-success'}) }}
        {% endfor %}
        {% if send_error %}
            {{ include('shared/ui/_alert.html.twig', {variant: 'error', body: 'contact.send_error'|trans, testid: 'contact-error'}) }}
        {% endif %}
    </div>
{% endblock %}
